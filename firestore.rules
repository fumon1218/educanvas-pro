rules_version = '2';

// EduCanvas Pro - Firestore 보안 규칙
// 배포: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }

    // 관리자 계정 (src/lib/access.ts의 ADMIN_EMAIL과 같아야 함)
    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'fumon1218@gmail.com';
    }

    // 관리자이거나, 관리자가 허용 목록(allowedUsers)에 등록한 계정
    function isAllowed() {
      return isAdmin() || (
        isAuthenticated() &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()))
      );
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function boardOwner(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)).data.ownerId;
    }

    function isValidBoard() {
      return request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt', 'updatedAt']) &&
             isValidString('name', 1, 100) &&
             request.resource.data.ownerId is string &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.updatedAt is timestamp;
    }

    function isValidScene() {
      return request.resource.data.keys().hasOnly(['name', 'data', 'order', 'updatedAt', 'updatedBy']) &&
             isValidString('name', 1, 100) &&
             isValidString('data', 0, 900000) &&
             request.resource.data.order is number &&
             request.resource.data.updatedAt is timestamp &&
             request.resource.data.updatedBy == request.auth.uid;
    }

    // 사용 허락 목록: 문서 ID = 소문자 이메일
    match /allowedUsers/{email} {
      // 관리자는 전체 관리, 본인은 자기 문서만 확인 가능(입장 확인용)
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email.lower() == email);
      allow create, update: if isAdmin() &&
                               request.resource.data.keys().hasOnly(['name', 'addedAt', 'addedBy']) &&
                               request.resource.data.name is string && request.resource.data.name.size() <= 40 &&
                               request.resource.data.addedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /boards/{boardId} {
      // 허용된 계정 중 링크(보드 ID)를 아는 사람만 읽기. 목록 조회는 허용하지 않음.
      allow get: if isAllowed();
      allow list: if false;

      allow create: if isAllowed() && isValidBoard() && request.resource.data.ownerId == request.auth.uid;
      // 보드 정보 수정·삭제는 만든 사람만
      allow update: if isAllowed() && isValidBoard() &&
                       resource.data.ownerId == request.auth.uid &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      match /scenes/{sceneId} {
        allow read: if isAllowed();
        // 함께 판서: 보드가 있는 경우에만 허용된 계정이 쓰기 가능
        allow create, update: if isAllowed() && exists(/databases/$(database)/documents/boards/$(boardId)) && isValidScene();
        // 슬라이드 삭제는 보드를 만든 사람만
        allow delete: if isAuthenticated() && boardOwner(boardId) == request.auth.uid;
      }
    }

    // 그 밖의 모든 문서는 접근 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
